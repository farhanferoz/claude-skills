{
  "description": "On every session start (including after /clear), read RESUME.md back into context.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/resume-autoload.sh\""
          }
        ]
      }
    ]
  }
}
